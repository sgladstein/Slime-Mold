     assert_eq!(Game::new(race_world(1, 1, 1_000), r, 1).with_tier(None).core_rule, Core::of(&r));
 }
 
+/// The strikers' settled peak (`StrikerRules::settle`): none while the
+/// slime falls from its landing, then its peak from the second it is 1%
+/// over its lowest; it holds as the slime falls again, and `settle` game
+/// seconds end the wait whatever the slime does.
+#[test]
+fn the_strikers_peak_waits_for_the_slime_to_settle() {
+    let mut g = small(1);
+    let m = g.mould.max(1_000);
+    g.mould = m;
+    assert_eq!(g.settled_peak(60.0), 0);
+    g.mould = m / 2;
+    assert_eq!(g.settled_peak(60.0), 0, "falling from the landing: not settled");
+    g.mould = m / 2 + m / 50;
+    let p = g.settled_peak(60.0);
+    assert_eq!(p, g.mould, "settled at its first rise, nothing killed");
+    g.mould = m / 4;
+    assert_eq!(g.settled_peak(60.0), p, "the peak holds as it falls again");
+    let mut late = small(1);
+    late.mould = m;
+    assert_eq!(late.settled_peak(late.time()), m, "settle seconds end the wait");
+    // What was killed before it settled counts back in, up to the
+    // game's peak: a slime that fell only under the guns keeps its peak.
+    let mut shot = small(1);
+    (shot.peak, shot.mould, shot.killed) = (m, m / 2, (m / 2) as u32);
+    assert_eq!(shot.settled_peak(shot.time()), m);
+    let mut over = small(1);
+    (over.peak, over.mould, over.killed) = (m, m / 2, m as u32);
+    assert_eq!(over.settled_peak(over.time()), m, "never past the game's peak");
+}
