+    /// The strikers' peak with `settle` on (`StrikerRules::settle`): 0
+    /// until the slime settles, then its peak from there.
+    pub(super) fn settled_peak(&mut self, settle: f32) -> usize {
+        let (t, mould, killed, landing) = (self.time(), self.mould, self.killed as usize, self.peak);
+        let st = &mut self.strikers;
