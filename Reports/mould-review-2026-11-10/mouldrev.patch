+/// Review hands for The Wild One: one opening move, then nothing.
+struct Opener {
+    kind: &'static str,
+    done: bool,
+}
+impl Player for Opener {
+    fn name(&self) -> &'static str {
+        self.kind
+    }
+    fn act(&mut self, d: &mut Dish) {
+        if d.phase != Phase::Growing || d.rival.is_none() {
+            return;
+        }
+        let sps = STEPS_PER_SECOND as u64;
+        let r = d.rival.as_ref().unwrap();
+        let n = r.walkers.len().max(1) as f32;
+        let (cx, cy) = (r.walkers.iter().map(|w| w.x).sum::<f32>() / n, r.walkers.iter().map(|w| w.y).sum::<f32>() / n);
+        match self.kind {
+            // The lamp held on the wild mould's middle all game.
+            "camp" => {
+                d.set_lamp(Some((cx, cy)));
+            }
+            // The lamp held on the wild mould's start pile all game.
+            "camphome" => {
+                if !self.done {
+                    self.done = true;
+                    d.set_lamp(Some((cx, cy)));
+                }
+            }
+            "nestsnip" => {
+                if !self.done && d.t >= sps / 2 {
+                    self.done = true;
+                    for k in 0..3 {
+                        let oy = (k as f32 - 1.0) * 7.0;
+                        if d.begin_stroke(Tool::Snip, cx - 13.0, cy + oy) {
+                            d.drag_stroke(cx + 13.0, cy + oy);
+                            d.end_stroke();
+                        }
+                    }
+                    println!("    nestsnip: wild {} -> after strokes (next step)", r_len(d));
+                }
+            }
+            "nestsalt" => {
+                if !self.done && d.t >= sps / 2 {
+                    self.done = true;
+                    if d.begin_stroke(Tool::Salt, cx - 30.0, cy) {
+                        d.drag_stroke(cx + 30.0, cy);
+                        d.end_stroke();
+                    }
+                }
+            }
+            "jail" => {
+                if !self.done && d.t >= sps / 2 {
+                    self.done = true;
+                    let rr = 9.5f32;
+                    if d.begin_stroke(Tool::Salt, cx + rr, cy) {
+                        for k in 1..=64 {
+                            let a = k as f32 / 64.0 * std::f32::consts::TAU;
+                            d.drag_stroke(cx + rr * a.cos(), cy + rr * a.sin());
+                        }
+                        d.end_stroke();
+                    }
+                }
+            }
+            // All three at once: salt through the nest, three snips, then camp the lamp.
+            "strike" => {
+                if !self.done && d.t >= sps / 2 {
+                    self.done = true;
+                    if d.begin_stroke(Tool::Salt, cx, cy - 30.0) {
+                        d.drag_stroke(cx, cy + 30.0);
+                        d.end_stroke();
+                    }
+                    for k in 0..3 {
+                        let oy = (k as f32 - 1.0) * 7.0;
+                        if d.begin_stroke(Tool::Snip, cx - 13.0, cy + oy) {
+                            d.drag_stroke(cx + 13.0, cy + oy);
+                            d.end_stroke();
+                        }
+                    }
+                }
+                d.set_lamp(Some((cx, cy)));
+            }
+            _ => {}
+        }
+    }
+}
+fn r_len(d: &Dish) -> usize {
+    d.rival.as_ref().map_or(0, |r| r.walkers.len())
+}
