+static JSTATE: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0x9E37_79B9_7F4A_7C15);
+fn envf(k: &str, d: f32) -> f32 {
+    std::env::var(k).ok().and_then(|v| v.parse().ok()).unwrap_or(d)
+}
+fn jrand() -> f32 {
+    use std::sync::atomic::Ordering::Relaxed;
+    let mut x = JSTATE.load(Relaxed);
+    x ^= x << 13;
+    x ^= x >> 7;
+    x ^= x << 17;
+    JSTATE.store(x, Relaxed);
+    (x >> 40) as f32 / (1u64 << 24) as f32
+}
+/// A hand's aim error: a point in a disc of radius `HJIT` cells.
+fn jit((x, y): (f32, f32)) -> (f32, f32) {
+    let r = envf("HJIT", 0.0);
+    if r <= 0.0 {
+        return (x, y);
+    }
+    let a = jrand() * std::f32::consts::TAU;
+    let d = jrand().sqrt() * r;
+    (x + a.cos() * d, y + a.sin() * d)
+}
