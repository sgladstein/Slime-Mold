+    /// Arming (`Rules::arming`): a soldier's bullet is drawn from the
+    /// soldier but traced only past its touch circle and a blast radius,
+    /// so its blast can't reach the walkers touching it; the range left
+    /// counts from the soldier. A turret's shot and `arming` off strike
+    /// from the first cell; so does a ray, past the same stretch.
+    #[test]
+    fn a_soldiers_own_blast_spares_the_walkers_touching_it() {
+        let mut g = small(1);
+        let sc = g.s();
+        let s = g.soldiers[0];
+        let to = (0..16).map(|k| k as f32 / 16.0 * std::f32::consts::TAU).map(|a| (s.x + 15.0 * sc * a.cos(), s.y + 15.0 * sc * a.sin())).find(|&p| g.clear_line((s.x, s.y), p)).expect("open ground by the larder");
+        let shot = ShotIn { from: (s.x, s.y), to, r: 2.5 * sc };
+        let d = |p: (f32, f32)| (p.0 - s.x).hypot(p.1 - s.y);
+        let arm = g.rules.touch * sc + shot.r;
+        let leg = g.rules.bullet_speed * sc / 15.0;
+        let (legs, _, drawn) = g.fly(vec![shot], &[Some(0)], 1.0 / 15.0);
+        assert!((d(legs[0].from) - arm).abs() < 1e-3, "traced from {} cells, arming {arm}", d(legs[0].from));
+        assert!((d(legs[0].to) - (arm + leg)).abs() < 1e-3, "the first leg flies its arming stretch too");
+        assert_eq!(drawn[0], (s.x, s.y), "drawn from the soldier");
+        // Every cell the blast can take is outside the touch circle.
+        assert!(d(legs[0].from) - shot.r >= g.rules.touch * sc - 1e-3);
+        g.landed(&legs, &[squad::ShotOut { hit: None, killed: 0 }]);
+        assert_eq!(g.bullets[0].arm, 0.0, "armed once");
+        assert!((g.bullets[0].left - (d(to) - arm - leg)).abs() < 1e-3, "range spent from the soldier: {}", g.bullets[0].left);
+        let (legs, _, drawn) = g.fly(Vec::new(), &[], 1.0 / 15.0);
+        assert_eq!(legs[0].from, drawn[0], "later legs are traced whole");
+        // A turret's shot, and the old rule.
+        g.bullets.clear();
+        let (legs, _, _) = g.fly(vec![shot], &[None], 1.0 / 15.0);
+        assert_eq!(legs[0].from, shot.from, "a turret strikes at once");
+        g.bullets.clear();
+        g.rules.arming = false;
+        let (legs, _, _) = g.fly(vec![shot], &[Some(0)], 1.0 / 15.0);
+        assert_eq!(legs[0].from, shot.from, "arming off");
+        // Rays (bullet_speed 0) start past the stretch.
+        g.bullets.clear();
+        (g.rules.arming, g.rules.bullet_speed) = (true, 0.0);
+        let (legs, _, drawn) = g.fly(vec![shot], &[Some(0)], 1.0 / 15.0);
+        assert!((d(legs[0].from) - arm).abs() < 1e-3 && legs[0].to == to && drawn[0] == shot.from, "{:?}", legs[0]);
+    }
